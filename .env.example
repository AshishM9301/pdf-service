# Upstash Redis (free tier at https://console.upstash.com)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# URL of your Next.js app (used to build webhook URLs for job completion callbacks)
# For local development: http://localhost:3000
# For production: https://your-nextjs-app.vercel.app (or your actual domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook secret — must match NEXT_PUBLIC_PDF_SERVICE_WEBHOOK_SECRET in the main app
# Generate with: openssl rand -base64 32
PDF_SERVICE_WEBHOOK_SECRET=your_webhook_secret_here
